# Heimdallr_Call 환경변수 템플릿
# 이 파일을 .env 로 복사해 값을 채운다. .env 는 절대 커밋하지 않는다.
# ★ os.environ을 직접 읽지 마라. 반드시 src/utils/env.py의 require_env/optional_env.
#   (값에 개행이 섞여 LLM 호출이 6일간 조용히 실패한 사고가 있었다 — traps.md T9)

# ── LLM ──
ANTHROPIC_API_KEY=

# ── DART (OpenDART) ──
OPENDART_API_KEY=

# ── 한국투자증권 KIS Open API (시세 조회 전용 · 주문 API 호출 금지) ──
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_PAPER_TRADING=false

# ── 텔레그램 (@Invest_EarningCallBot · HermesCall과 봇 토큰 공유) ──
# ★ setWebhook을 절대 호출하지 마라. Heimdallr는 sendMessage 발송 전용이다.
# ★ Heimdallr 전용 봇을 쓴다. HermesCall과 같은 봇을 쓰면 수신(getUpdates)이 차단된다 —
#   공유 봇에서 폴링하면 상대 메시지를 가로채 소비하기 때문이다(traps.md T44).
#   전용 토큰이 있으면 HEIMDALLR_* 를 우선 쓰고, 없으면 아래 공용 값으로 떨어진다.
HEIMDALLR_TELEGRAM_BOT_TOKEN=
HEIMDALLR_TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 수신에 응답할 chat을 추가로 허용한다(쉼표 구분). 비우면 위 chat 하나만 응답한다.
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Supabase (Heimdallr 전용 신규 프로젝트 — HermesCall과 분리, ADR 8) ──
# ★ SUPABASE_URL에 /rest/v1을 붙이지 마라. supabase-py가 스스로 붙인다.
# ★ 프로젝트 ref(https://<ref>.supabase.co)가 HermesCall과 다른지 눈으로 대조할 것.
# 2026 기준 신규 프로젝트 키 형식: sb_secret_... / sb_publishable_...
SUPABASE_URL=https://<your-new-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...

# ── 대시보드(Next.js) — 같은 프로젝트, 키만 publishable(저권한) ──
# ⚠️ sb_secret_... 를 NEXT_PUBLIC_* 에 절대 넣지 마라. RLS를 우회한다.
NEXT_PUBLIC_SUPABASE_URL=https://<your-new-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
DASHBOARD_BASE_URL=https://heimdallr-call.vercel.app

# ── 비용 가드레일 (기본값은 src/config/constants.py) ──
# ★ 여기 값이 코드 기본값과 다르면, 이 파일을 복사해 만든 로컬 `.env`만
#   조용히 다른 상한으로 돈다 — 로컬과 CI가 어긋난다(T82 실측: 8/20 vs 20/80).
#   `tests/test_constants_export.py`가 이 두 줄을 constants.py와 대조한다.
MONTHLY_COST_CEILING_USD=27
DAILY_ANALYSIS_LIMIT=120

# ── 운영 ──
# on  = 실적 시즌 (공시 폴링 15분 주기)
# off = 비시즌   (하루 4회)
SEASON_MODE=off
